<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ConversationMessage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox" id="summary">
        <property name="orientation">horizontal</property>
        <property name="hexpand">True</property>
        <property name="spacing">12</property>
        <child>
          <object class="AdwAvatar" id="avatar">
            <property name="valign">start</property>
            <property name="show-initials">True</property>
            <property name="size">48</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="hexpand">True</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox" id="compact_header">
                <property name="hexpand">True</property>
                <property name="orientation">vertical</property>

                <child>
                  <object class="GtkBox" id="compact_from_header">
                    <property name="orientation">horizontal</property>
                    <property name="hexpand">True</property>
                    <child>
                      <object class="GtkLabel" id="compact_from">
                        <property name="visible">True</property>
                        <property name="hexpand">True</property>
                        <property name="label" translatable="yes">From &lt;email&gt;</property>
                        <property name="ellipsize">end</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="convey-header"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="compact_date">
                        <property name="label" translatable="yes">1/1/1970	</property>
                        <property name="ellipsize">end</property>
                        <style>
                          <class name="convey-header-value"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="compact_body">
                    <property name="halign">start</property>
                    <property name="hexpand">True</property>
                    <property name="label" translatable="yes">Preview body text.</property>
                    <property name="ellipsize">end</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="convey-header-value"/>
                    </style>
                  </object>
                </child>
                <style>
                  <class name="convey-headers"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="expanded_header">
                <property name="visible">False</property>
                <property name="hexpand">True</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkGrid" id="from_header">
                    <property name="hexpand">True</property>
                    <property name="orientation">horizontal</property>
                    <child>
                      <object class="GtkFlowBox" id="from">
                        <property name="valign">center</property>
                        <property name="hexpand">True</property>
                        <property name="column_spacing">4</property>
                        <property name="homogeneous">False</property>
                        <property name="max_children_per_line">4</property>
                        <property name="selection_mode">none</property>
                        <signal name="child-activated" handler="on_address_box_child_activated"/>
                        <style>
                          <class name="convey-header-value"/>
                          <class name="convey-from-addresses"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="date">
                        <property name="valign">center</property>
                        <property name="label" translatable="yes">1/1/1970	</property>
                        <property name="ellipsize">end</property>
                        <style>
                          <class name="convey-header-value"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="subject">
                    <property name="visible">False</property>
                    <property name="halign">start</property>
                    <property name="hexpand">True</property>
                    <property name="label" translatable="yes">Subject</property>
                    <property name="wrap">True</property>
                    <property name="wrap_mode">word-char</property>
                    <property name="selectable">True</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="convey-header-value"/>
                      <class name="convey-subject"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="recipients_row">
                    <property name="orientation">horizontal</property>
                    <child>
                      <object class="GtkImage" id="encryption_icon">
                        <property name="visible">False</property>
                        <property name="valign">center</property>
                        <property name="margin-end">6</property>
                        <property name="icon-name">channel-secure-symbolic</property>
                        <property name="tooltip_text" translatable="yes">This message was encrypted</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton">
                        <property name="halign">start</property>
                        <property name="always-show-arrow">True</property>
                        <child>
                          <object class="GtkLabel" id="recipients_summary">
                            <property name="ellipsize">end</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                        <property name="popover">
                          <object class="GtkPopover">
                            <child>
                              <object class="AdwClamp">
                                <property name="maximum-size">420</property>
                                <property name="tightening-threshold">420</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkBox" id="details_from_header">
                                        <property name="visible">False</property>
                                        <property name="orientation">horizontal</property>
                                        <child>
                                          <object class="GtkLabel" id="details_from_label">
                                            <property name="label" translatable="yes">From</property>
                                            <property name="xalign">0</property>
                                            <property name="yalign">0</property>
                                            <style>
                                              <class name="dim-label"/>
                                              <class name="convey-header"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="ConversationMessageContactList" id="from_list">
                                            <property name="valign">start</property>
                                            <property name="hexpand">True</property>
                                            <signal name="child-activated" handler="on_address_box_child_activated"/>
                                            <style>
                                              <class name="convey-header-value"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="sender_header">
                                        <property name="visible">False</property>
                                        <property name="orientation">horizontal</property>
                                        <child>
                                          <object class="GtkLabel" id="sender_label">
                                            <property name="label" translatable="yes">Sent by</property>
                                            <property name="xalign">0</property>
                                            <property name="yalign">0</property>
                                            <style>
                                              <class name="dim-label"/>
                                              <class name="convey-header"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkFlowBox" id="sender_address">
                                            <property name="visible">False</property>
                                            <property name="valign">start</property>
                                            <property name="hexpand">True</property>
                                            <property name="column_spacing">4</property>
                                            <property name="homogeneous">False</property>
                                            <property name="max_children_per_line">1</property>
                                            <property name="selection_mode">none</property>
                                            <signal name="child-activated" handler="on_address_box_child_activated"/>
                                            <style>
                                              <class name="convey-header-value"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="reply_to_header">
                                        <property name="visible">False</property>
                                        <property name="orientation">horizontal</property>
                                        <child>
                                          <object class="GtkLabel" id="reply_to_label">
                                            <property name="label" translatable="yes">Reply to</property>
                                            <property name="xalign">0</property>
                                            <property name="yalign">0</property>
                                            <style>
                                              <class name="dim-label"/>
                                              <class name="convey-header"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkFlowBox" id="reply_to_addresses">
                                            <property name="valign">start</property>
                                            <property name="hexpand">True</property>
                                            <property name="column_spacing">4</property>
                                            <property name="homogeneous">False</property>
                                            <property name="max_children_per_line">1</property>
                                            <property name="selection_mode">none</property>
                                            <signal name="child-activated" handler="on_address_box_child_activated"/>
                                            <style>
                                              <class name="convey-header-value"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="to_header">
                                        <property name="visible">False</property>
                                        <property name="orientation">horizontal</property>
                                        <child>
                                          <object class="GtkLabel" id="to_label">
                                            <property name="label" translatable="yes">To</property>
                                            <property name="xalign">0</property>
                                            <property name="yalign">0</property>
                                            <style>
                                              <class name="dim-label"/>
                                              <class name="convey-header"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="ConversationMessageContactList" id="to_list">
                                            <property name="valign">start</property>
                                            <property name="hexpand">True</property>
                                            <signal name="child-activated" handler="on_address_box_child_activated"/>
                                            <style>
                                              <class name="convey-header-value"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="cc_header">
                                        <property name="orientation">horizontal</property>
                                        <property name="visible">False</property>
                                        <child>
                                          <object class="GtkLabel" id="cc_label">
                                            <property name="label" translatable="yes">Cc</property>
                                            <property name="xalign">0</property>
                                            <property name="yalign">0</property>
                                            <style>
                                              <class name="dim-label"/>
                                              <class name="convey-header"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="ConversationMessageContactList" id="cc_list">
                                            <property name="valign">start</property>
                                            <property name="hexpand">True</property>
                                            <signal name="child-activated" handler="on_address_box_child_activated"/>
                                            <style>
                                              <class name="convey-header-value"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="bcc_header">
                                        <property name="orientation">horizontal</property>
                                        <property name="visible">False</property>
                                        <child>
                                          <object class="GtkLabel" id="bcc_label">
                                            <property name="label" translatable="yes">Bcc</property>
                                            <property name="xalign">0</property>
                                            <property name="yalign">0</property>
                                            <style>
                                              <class name="dim-label"/>
                                              <class name="convey-header"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="ConversationMessageContactList" id="bcc_list">
                                            <property name="valign">start</property>
                                            <property name="hexpand">True</property>
                                            <signal name="child-activated" handler="on_address_box_child_activated"/>
                                            <style>
                                              <class name="convey-header-value"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <child>
                                          <object class="GtkLabel" id="details_date_label">
                                            <property name="label" translatable="yes">Date</property>
                                            <property name="xalign">0</property>
                                            <property name="yalign">0</property>
                                            <style>
                                              <class name="dim-label"/>
                                              <class name="convey-header"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="details_date">
                                            <property name="xalign">0</property>
                                            <property name="hexpand">True</property>
                                            <style>
                                              <class name="convey-header-value"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <style>
                                      <class name="convey-headers"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                        <style>
                          <class name="flat"/>
                          <class name="convey-recipients"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <style>
                  <class name="convey-headers"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <style>
          <class name="convey-message-summary"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkRevealer" id="body_revealer">
        <property name="transition_type">slide-up</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="ComponentsInfoBarStack" id="info_bars">
                <property name="visible">False</property>
                <property name="algorithm">priority-queue</property>
              </object>
            </child>
            <child>
              <object class="GtkOverlay">
                <property name="height_request">6</property>
                <child>
                  <object class="GtkBox" id="body_container">
                    <property name="orientation">vertical</property>
                    <style>
                      <class name="convey-message-body"/>
                    </style>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkProgressBar" id="body_progress">
                    <property name="valign">start</property>
                    <style>
                      <class name="convey-body-progress"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <style>
      <class name="convey-message"/>
    </style>
  </template>
  <object class="GtkSizeGroup">
    <property name="mode">vertical</property>
    <widgets>
      <widget name="compact_body"/>
      <widget name="recipients_row"/>
    </widgets>
  </object>
  <object class="GtkSizeGroup">
    <property name="mode">horizontal</property>
    <widgets>
      <widget name="details_from_label"/>
      <widget name="sender_label"/>
      <widget name="reply_to_label"/>
      <widget name="to_label"/>
      <widget name="cc_label"/>
      <widget name="bcc_label"/>
      <widget name="details_date_label"/>
    </widgets>
  </object>
</interface>
