<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <menu id="contact_menu">
    <section>
      <item>
        <attribute name="custom">header</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">New Conversation…</attribute>
        <attribute name="action">con.new-conversation</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Copy Email Address</attribute>
        <attribute name="action">con.copy-email</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Show Conversations</attribute>
        <attribute name="action">con.show-conversations</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Open in Contacts</attribute>
        <attribute name="action">con.open</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save in Contacts…</attribute>
        <attribute name="action">con.save</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Always Load Remote Images</attribute>
        <attribute name="action">con.load-remote</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
  </menu>
</interface>
