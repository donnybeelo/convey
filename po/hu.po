msgstr "A Convey néhány funkciója:"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:34
msgid "Quick email account setup"
msgstr "Gyors e-mailfiók beállítás"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:35
