#: desktop/convey-attach.contract.desktop.in:2
msgid "Send by email"
msgstr "Envoyer par courriel"

#: desktop/convey-attach.contract.desktop.in:5
msgid "Send files using Convey"
msgstr "Envoyer des fichiers avec Convey"

#. Translators: The application name
#: desktop/convey-autostart.desktop.in.in:2 desktop/net.donnybeelo.Convey.desktop.in.in:2
#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:11
#: src/client/application/application-main-window.vala:598 ui/accounts_editor_servers_pane.ui:56
msgid "Convey"
msgstr "Convey"

#: desktop/convey-autostart.desktop.in.in:3 desktop/net.donnybeelo.Convey.desktop.in.in:3
msgid "Email"
msgstr "Courriel"

#. Translators: The application's summary / tagline
#: desktop/convey-autostart.desktop.in.in:4 desktop/net.donnybeelo.Convey.desktop.in.in:4
#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:17
#: src/client/application/application-client.vala:18
msgid "Send and receive email"
msgstr "Envoyer et recevoir des courriels"

#. Translators: These are desktop search terms. Do not translate semicolons, end line with a semicolon.
#: desktop/convey-autostart.desktop.in.in:6
msgid "Email;E-mail;Mail;"
msgstr "Email;E-mail;Messagerie;Courriels;"

#. Translators: These are desktop search terms. Do not translate semicolons, end line with a semicolon.
#: desktop/net.donnybeelo.Convey.desktop.in.in:6
msgid "Mail;E-mail;email;IMAP;GMail;Yahoo;Hotmail;Outlook;"
msgstr "Messagerie;Mail;Courriel;email;E-mail;IMAP;GMail;Yahoo;Hotmail;Outlook;"

#: desktop/net.donnybeelo.Convey.desktop.in.in:23
msgid "Compose Message"
msgstr "Écrire un message"

#: desktop/net.donnybeelo.Convey.desktop.in.in:27
msgid "New Window"
msgstr "Nouvelle fenêtre"

#: desktop/net.donnybeelo.Convey.gschema.xml:8
msgid "Maximize window"
msgstr "Maximiser la fenêtre"

#: desktop/net.donnybeelo.Convey.gschema.xml:9
msgid "True if the application window is maximized, false otherwise."
msgstr "Vrai si la fenêtre de l’application est maximisée, faux sinon."

#: desktop/net.donnybeelo.Convey.gschema.xml:14
msgid "Width of window"
msgstr "Largeur de la fenêtre"

#: desktop/net.donnybeelo.Convey.gschema.xml:15
msgid "The last recorded width of the application window."
msgstr "La dernière largeur enregistrée pour la fenêtre de l’application."

#: desktop/net.donnybeelo.Convey.gschema.xml:20
msgid "Height of window"
msgstr "Hauteur de la fenêtre"

#: desktop/net.donnybeelo.Convey.gschema.xml:21
msgid "The last recorded height of the application window."
msgstr "La dernière hauteur enregistrée pour la fenêtre de l’application."

#: desktop/net.donnybeelo.Convey.gschema.xml:26
msgid "Show/hide formatting toolbar"
msgstr "Afficher/masquer la barre d’outils de mise en forme"

#: desktop/net.donnybeelo.Convey.gschema.xml:27
msgid "True if the formatting toolbar in the composer is shown."
msgstr "Vrai si la barre d’outils de mise en forme dans l’éditeur est affichée."

#: desktop/net.donnybeelo.Convey.gschema.xml:32
msgid "Autoselect next message"
msgstr "Sélectionner automatiquement le message suivant"

#: desktop/net.donnybeelo.Convey.gschema.xml:33
msgid "True if we should autoselect the next available conversation."
msgstr "Vrai si la conversation suivante doit être sélectionnée automatiquement."

#: desktop/net.donnybeelo.Convey.gschema.xml:38
msgid "Display message previews"
msgstr "Afficher les aperçus des messages"

#: desktop/net.donnybeelo.Convey.gschema.xml:39
msgid "True if we should display a short preview of each message."
msgstr "Vrai si un court aperçu de chaque message doit être affiché."

#: desktop/net.donnybeelo.Convey.gschema.xml:44
msgid "Display conversation participants"
msgstr "Afficher les participants de la conversation"

#: desktop/net.donnybeelo.Convey.gschema.xml:45
msgid "True if we should display the participants of each conversation in the conversation list."
msgstr ""
"Vrai si les participants de chaque conversation doivent être affichés dans la liste des "
"conversations."

#: desktop/net.donnybeelo.Convey.gschema.xml:50
msgid "Display conversation subjects"
msgstr "Afficher les objets des conversations"

#: desktop/net.donnybeelo.Convey.gschema.xml:51
msgid "True if we should display the subject of each conversation in the conversation list."
msgstr "Vrai si l’objet de chaque conversation doit être affiché dans la liste des conversations."

#: desktop/net.donnybeelo.Convey.gschema.xml:56
msgid "Conversation list line order"
msgstr "Ordre des lignes de la liste des conversations"

#: desktop/net.donnybeelo.Convey.gschema.xml:57
msgid ""
"The order of the participants, subject and preview lines of each conversation in the conversation "
"list."
msgstr ""
"L’ordre des lignes des participants, de l’objet et de l’aperçu de chaque conversation dans la "
"liste des conversations."

#: desktop/net.donnybeelo.Convey.gschema.xml:63
msgid "Override colors in HTML emails"
msgstr "Remplacer les couleurs des courriels HTML"

#: desktop/net.donnybeelo.Convey.gschema.xml:64 ui/components-preferences-dialog.ui:93
msgid "Overrides the original colors in HTML messages to integrate better with the app theme."
msgstr ""
"Remplace les couleurs d’origine des messages HTML pour mieux s’intégrer au thème de l’application."

#: desktop/net.donnybeelo.Convey.gschema.xml:69
msgid "Move messages by default"
msgstr "Déplacer les messages par défaut"

#: desktop/net.donnybeelo.Convey.gschema.xml:70
msgid "When tagging a message, move it to destination folder."
msgstr "Lors de l’étiquetage d’un message, le déplacer vers le dossier de destination."

#: desktop/net.donnybeelo.Convey.gschema.xml:75
msgid "Use single key shortcuts"
msgstr "Utiliser les raccourcis clavier d’une seule touche"

#: desktop/net.donnybeelo.Convey.gschema.xml:76
msgid ""
"Enables shortcuts for email actions that do not require pressing <Ctrl> to emulate those used by "
"Gmail."
msgstr ""
"Active les raccourcis pour les actions courriels ne nécessitant pas l’utilisation de <Ctrl> pour "
"émuler ceux utilisés par Gmail."

#: desktop/net.donnybeelo.Convey.gschema.xml:83
msgid "Languages that shall be used in the spell checker"
msgstr "Langues à utiliser pour le vérificateur orthographique"

#: desktop/net.donnybeelo.Convey.gschema.xml:84
msgid ""
"A list of POSIX locales, with the empty list disabling spell checking and the null list using "
"desktop languages by default."
msgstr ""
"Liste des langues POSIX ; la liste vide désactive la correction automatique et la liste nulle "
"permet d’utiliser les langues par défaut du bureau."

#: desktop/net.donnybeelo.Convey.gschema.xml:91
msgid "Languages that are displayed in the spell checker popover"
msgstr "Langues à afficher dans la fenêtre contextuelle du vérificateur orthographique"

#: desktop/net.donnybeelo.Convey.gschema.xml:92
msgid "List of languages that are always displayed in the popover of the spell checker."
msgstr ""
"Liste des langues qui sont toujours affichées dans la fenêtre contextuelle du vérificateur "
"orthographique."

#: desktop/net.donnybeelo.Convey.gschema.xml:97
msgid "Run application in background on logon and when closed"
msgstr "Exécuter l’application en arrière-plan à l’ouverture et après la fermeture"

#: desktop/net.donnybeelo.Convey.gschema.xml:98
msgid "True to run application in background."
msgstr "Activer pour exécuter l’application en arrière-plan."

#: desktop/net.donnybeelo.Convey.gschema.xml:103
msgid "Ask when opening an attachment"
msgstr "Demander lors de l’ouverture d’une pièce jointe"

#: desktop/net.donnybeelo.Convey.gschema.xml:104
msgid "True to ask when opening an attachment."
msgstr "Vrai pour demander lors de l’ouverture d’une pièce jointe."

#: desktop/net.donnybeelo.Convey.gschema.xml:109
msgid "Whether to compose emails in HTML"
msgstr "Composer les courriels en HTML"

#: desktop/net.donnybeelo.Convey.gschema.xml:110
msgid "True to compose emails in HTML; false for plain text."
msgstr "Vrai pour composer les messages en HTML, faux pour du texte simple."

#: desktop/net.donnybeelo.Convey.gschema.xml:115
msgid "Advisory strategy for full-text searching"
msgstr "Stratégie consultative pour la recherche de texte intégral"

#: desktop/net.donnybeelo.Convey.gschema.xml:116
msgid "Acceptable values are “exact”, “conservative”, “aggressive”, and “horizon”."
msgstr ""
"Les valeurs acceptables sont \"exact\" (« exacte »), \"conservative\" (« conservatrice »), "
"\"aggressive\" et \"horizon\"."

#: desktop/net.donnybeelo.Convey.gschema.xml:121
msgid "Zoom of conversation viewer"
msgstr "Zoom de l’afficheur de conversation"

#: desktop/net.donnybeelo.Convey.gschema.xml:122
msgid "The zoom to apply on the conservation view."
msgstr "Le zoom à appliquer sur la vue de conversation."

#: desktop/net.donnybeelo.Convey.gschema.xml:127
msgid "Sidebar width fraction"
msgstr "Fraction de largeur de la barre latérale"

#: desktop/net.donnybeelo.Convey.gschema.xml:128
msgid "Fraction of the window width used by the sidebar, or 0 for the default width."
msgstr ""
"Fraction de la largeur de la fenêtre occupée par la barre latérale, ou 0 pour la largeur par "
"défaut."

#: desktop/net.donnybeelo.Convey.gschema.xml:133
msgid "Folder list width"
msgstr "Largeur de la liste des dossiers"

#: desktop/net.donnybeelo.Convey.gschema.xml:134
msgid "Width of the folder list in pixels, or 0 for the default width."
msgstr "Largeur de la liste des dossiers en pixels, ou 0 pour la largeur par défaut."

#: desktop/net.donnybeelo.Convey.gschema.xml:139
msgid "Size of detached composer window"
msgstr "Taille de la fenêtre d’édition détachée"

#: desktop/net.donnybeelo.Convey.gschema.xml:140
msgid "The last recorded size of the detached composer window."
msgstr "La dernière taille enregistrée de la fenêtre d’édition détachée."

#: desktop/net.donnybeelo.Convey.gschema.xml:145
msgid "Collapsed parts of the folder list"
msgstr "Parties repliées de la liste des dossiers"

#: desktop/net.donnybeelo.Convey.gschema.xml:146
msgid ""
"Accounts and folder groups left collapsed in the folder list, so they stay that way between "
"launches"
msgstr ""
"Comptes et groupes de dossiers laissés repliés dans la liste des dossiers, afin qu’ils le restent "
"d’un lancement à l’autre"

#: desktop/net.donnybeelo.Convey.gschema.xml:152
msgid "Reopen the inbox last viewed"
msgstr "Rouvrir la dernière boîte de réception consultée"

#: desktop/net.donnybeelo.Convey.gschema.xml:153
msgid "Open whichever inbox was last viewed when Convey starts, rather than a fixed one"
msgstr ""
"Ouvrir au démarrage de Convey la dernière boîte de réception consultée, plutôt qu’une boîte fixe"

#: desktop/net.donnybeelo.Convey.gschema.xml:159
msgid "Inbox to open at launch"
msgstr "Boîte de réception à ouvrir au lancement"

#: desktop/net.donnybeelo.Convey.gschema.xml:160
msgid ""
"Identifier of the account whose inbox was last opened, or \"all\" for the combined view of every "
"inbox"
msgstr ""
"Identifiant du compte dont la boîte de réception a été ouverte en dernier, ou « tous » pour la "
"vue combinée de toutes les boîtes de réception"

#: desktop/net.donnybeelo.Convey.gschema.xml:166
msgid "Always Show Starred Folder"
msgstr "Toujours afficher le dossier Favoris"

#: desktop/net.donnybeelo.Convey.gschema.xml:167 ui/components-preferences-dialog.ui:42
msgid "Show a local Starred folder for accounts whose server does not provide one"
msgstr "Afficher un dossier Favoris local pour les comptes dont le serveur n’en fournit pas"

#: desktop/net.donnybeelo.Convey.gschema.xml:173
msgid "Use Custom Proxy"
msgstr "Utiliser un mandataire personnalisé"

#: desktop/net.donnybeelo.Convey.gschema.xml:174
msgid "Route all connections through a custom proxy instead of the system proxy settings"
msgstr ""
"Faire passer toutes les connexions par un mandataire personnalisé au lieu des paramètres de "
"mandataire du système"

#: desktop/net.donnybeelo.Convey.gschema.xml:180
msgid "Proxy Address"
msgstr "Adresse du mandataire"

#: desktop/net.donnybeelo.Convey.gschema.xml:181
msgid "URI of the proxy to use"
msgstr "URI du mandataire à utiliser"

#: desktop/net.donnybeelo.Convey.gschema.xml:186
msgid "Allow images for these domains"
msgstr "Autoriser les images provenant de ces domaines"

#: desktop/net.donnybeelo.Convey.gschema.xml:187
msgid "Images from these domains will be trusted"
msgstr "Les images depuis ces domaines seront acceptées"

#: desktop/net.donnybeelo.Convey.gschema.xml:192
msgid "Load images from unverified senders"
msgstr "Charger les images des expéditeurs non vérifiés"

#: desktop/net.donnybeelo.Convey.gschema.xml:193
msgid ""
"Also load images when all images are trusted but the sender could not be verified with DKIM or "
"DMARC"
msgstr ""
"Charger aussi les images lorsque toutes les images sont approuvées mais que l’expéditeur n’a pas "
"pu être vérifié avec DKIM ou DMARC"

#: desktop/net.donnybeelo.Convey.gschema.xml:199
msgid "Undo sending email delay"
msgstr "Annuler le délai d’envoi"

#: desktop/net.donnybeelo.Convey.gschema.xml:200
msgid "The number of seconds to wait before sending an email. Set to zero or less to disable."
msgstr ""
"Le nombre de secondes à attendre avant d’envoyer un courriel. Mettre à zéro ou moins pour "
"désactiver."

#: desktop/net.donnybeelo.Convey.gschema.xml:206
msgid "Brief notification display time"
msgstr "Temps d’affichage des notifications courtes"

#: desktop/net.donnybeelo.Convey.gschema.xml:207
msgid "The length of time in seconds for which brief notifications should be displayed."
msgstr "Durée en secondes pendant laquelle les notifications courtes doivent être affichées."

#: desktop/net.donnybeelo.Convey.gschema.xml:213
msgid "List of optional plugins"
msgstr "Liste des greffons facultatifs"

#: desktop/net.donnybeelo.Convey.gschema.xml:214
msgid "Plugins listed here will be loaded on startup."
msgstr "Les greffons listés ici seront chargés au démarrage."

#: desktop/net.donnybeelo.Convey.gschema.xml:219
msgid "Whether we migrated the old settings"
msgstr "Indique si les anciens paramètres ont été migrés"

#: desktop/net.donnybeelo.Convey.gschema.xml:220
msgid "False to check for the old “org.yorba.convey”-schema and copy its values."
msgstr "Faux pour chercher le vieux schéma « org.yorba.convey » et copier ses valeurs."

#. Translators: The developer's name
#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:14
msgid "Daniel Elia"
msgstr "Daniel Elia"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:19
msgid ""
"Convey is an email application built around conversations, for the GNOME desktop. It allows you "
"to read, find and send email with a straightforward, modern interface."
msgstr ""
"Convey est une application de messagerie construite autour de conversations, pour le bureau "
"GNOME. Elle permet de lire, rechercher et envoyer des courriels de façon simple, avec une "
"interface élégante."

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:24
msgid ""
"Conversations allow you to read a complete discussion without having to find and click from "
"message to message."
msgstr ""
"Les conversations permettent de lire les échanges sans avoir à naviguer d’un message à un autre."

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:28
msgid ""
"Convey is a fork of Geary, originally developed by the Geary Development Team and the Software "
"Freedom Conservancy."
msgstr ""
"Convey est un fork de Geary, développé à l’origine par l’équipe de développement de Geary et la "
"Software Freedom Conservancy."

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:32
msgid "Convey’s features include:"
msgstr "Convey intègre les fonctionnalités suivantes :"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:34
msgid "Quick email account setup"
msgstr "Configuration rapide du compte de messagerie"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:35
msgid "Shows related messages together in conversations"
msgstr "Affichage des messages liés sous forme de conversation"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:36
msgid "Fast, full text and keyword search"
msgstr "Recherche rapide, par mot-clé ou par texte"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:37
msgid "Full-featured HTML and plain text message composer"
msgstr "Édition de courriel en texte simple ou enrichi en HTML"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:38
msgid "Desktop notification of new mail"
msgstr "Notification de nouveaux messages"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:39
msgid "Compatible with GMail, Yahoo! Mail, Outlook.com and other IMAP servers"
msgstr "Compatible avec GMail, Yahoo! Mail, Outlook.com et autres serveurs IMAP"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:52
msgid "Convey showing an inbox of conversations"
msgstr "Convey affichant une boîte de réception de conversations"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:56
msgid "Convey displaying a conversation"
msgstr "Convey affichant une conversation"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:60
msgid "Convey showing the rich text composer"
msgstr "Convey montrant l’éditeur de texte enrichi"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:82
msgid "Show nested folders on Microsoft accounts"
msgstr "Afficher les dossiers imbriqués sur les comptes Microsoft"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:83
msgid "Create subfolders from the folder list context menu within the app"
msgstr ""
"Créer des sous-dossiers depuis le menu contextuel de la liste des dossiers dans l’application"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:84
msgid "Open GNOME Online Accounts directly when adding an account"
msgstr "Ouvrir directement les Comptes en ligne GNOME lors de l’ajout d’un compte"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:91
msgid "Refreshed application icons, screenshots and branding colours"
msgstr "Icônes de l’application, captures d’écran et couleurs de marque actualisées"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:92
msgid "Add a combined \"All Inboxes\" view spanning every account"
msgstr "Ajout d’une vue combinée « Toutes les boîtes de réception » couvrant tous les comptes"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:93
msgid "Reopen the inbox last viewed at launch, or a fixed one of your choosing"
msgstr ""
"Rouvrir au lancement la dernière boîte de réception consultée, ou une boîte fixe de votre choix"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:94
msgid "Remember which parts of the folder list were left collapsed"
msgstr "Mémorisation des parties de la liste des dossiers laissées repliées"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:95
msgid "Add a Starred folder for Microsoft accounts, showing its total count"
msgstr "Ajout d’un dossier Favoris pour les comptes Microsoft, affichant son nombre total"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:96
msgid "Page through large folders on Graph accounts"
msgstr "Pagination des dossiers volumineux sur les comptes Graph"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:103
msgid "Persist folders from Graph accounts so they load offline"
msgstr "Conservation des dossiers des comptes Graph pour les charger hors ligne"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:104
msgid "Fix unpredictable folder keyboard navigation"
msgstr "Correction de la navigation imprévisible au clavier dans les dossiers"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:105
msgid "Deselect conversations on Escape, disable autoselect in Trash and Junk"
msgstr ""
"Désélection des conversations avec Échap, désactivation de la sélection automatique dans la "
"Corbeille et les Indésirables"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:106
msgid "Fix dark mode rendering in certain emails"
msgstr "Correction de l’affichage en mode sombre dans certains courriels"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:107
msgid "Fix context menu positioning in the message body"
msgstr "Correction du positionnement du menu contextuel dans le corps du message"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:108
msgid "Replace libcanberra and gsound with GStreamer for notification sounds"
msgstr "Remplacement de libcanberra et gsound par GStreamer pour les sons de notification"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:109
msgid "Drop the unused libspelling dependency"
msgstr "Suppression de la dépendance inutilisée à libspelling"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:110
msgid "Numerous user interface and styling fixes"
msgstr "De nombreuses corrections de l’interface et du style"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:116
msgid "The first Convey release, forked from Geary 46.0."
msgstr "La première version de Convey, issue d’un fork de Geary 46.0."

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:117
msgid "Enhancements included in this release:"
msgstr "Améliorations incluses dans cette version :"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:119
msgid "Ported the interface to GTK4 and libadwaita"
msgstr "Portage de l’interface vers GTK4 et libadwaita"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:120
msgid "Added a Microsoft Graph backend for Outlook and Microsoft 365 accounts"
msgstr "Ajout d’un moteur Microsoft Graph pour les comptes Outlook et Microsoft 365"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:121
msgid "Rebranded as Convey, with new application icons"
msgstr "Changement de marque en Convey, avec de nouvelles icônes d’application"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:122
msgid "Create, rename and delete folders from the sidebar"
msgstr "Création, renommage et suppression de dossiers depuis la barre latérale"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:123
msgid "Reworked conversation list with keyboard navigation between panes"
msgstr "Liste des conversations remaniée avec navigation au clavier entre les panneaux"

#: desktop/net.donnybeelo.Convey.metainfo.xml.in.in:124
