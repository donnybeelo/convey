{
    "app-id": "net.donnybeelo.Convey.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "master",
    "sdk": "org.gnome.Sdk",
    "command": "convey",
    "desktop-file-name-suffix": " (Development)",
    "tags": [
        "nightly"
    ],
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--talk-name=org.gnome.Contacts",
        "--talk-name=org.gnome.Settings",
        "--talk-name=org.gnome.OnlineAccounts",
        "--talk-name=org.gnome.evolution.dataserver.*",
        "--talk-name=org.gnome.keyring.SystemPrompter",
        "--system-talk-name=org.freedesktop.login1",
        "--filesystem=xdg-cache/evolution/addressbook:ro",
        "--metadata=X-DConf=migrate-path=/net/donnybeelo/Convey/",
        "--filesystem=~/.config/convey:ro",
        "--filesystem=~/.var/app/net.donnybeelo.Convey/config/convey:ro",
        "--filesystem=xdg-desktop",
        "--filesystem=/tmp"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/aclocal",
        "/share/gir-1.0",
        "/share/girepository-1",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/share/vala",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "gnome-online-accounts",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgoabackend=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/gnome-online-accounts.git",
                    "branch": "master"
                }
            ]
        },
        {
            "name": "libical",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS:BOOL=ON",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_INSTALL_LIBDIR=lib",
                "-DGOBJECT_INTROSPECTION=true",
                "-DICAL_BUILD_DOCS=false",
                "-DICAL_GLIB=true",
                "-DICAL_GLIB_VAPI=true"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libical/libical/releases/download/v3.0.20/libical-3.0.20.tar.gz",
                    "sha256": "e73de92f5a6ce84c1b00306446b290a2b08cdf0a80988eca0a2c9d5c3510b4c2"
                }
            ],
            "cleanup": [
                "/lib/cmake"
            ]
        },
        {
            "name": "evolution-data-server",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DENABLE_CANBERRA=OFF",
                "-DENABLE_EXAMPLES=OFF",
                "-DENABLE_GOA=ON",
                "-DENABLE_GTK=ON",
                "-DENABLE_GTK_DOC=OFF",
                "-DENABLE_INSTALLED_TESTS=OFF",
                "-DENABLE_INTROSPECTION=ON",
                "-DENABLE_VALA_BINDINGS=ON",
                "-DENABLE_WEATHER=OFF",
                "-DWITH_LIBDB=OFF",
                "-DENABLE_OAUTH2_WEBKITGTK=OFF",
                "-DWITH_OPENLDAP=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/evolution-data-server.git"
                }
            ],
            "cleanup": [
                "/lib/cmake",
                "/lib/evolution-data-server/*-backends",
                "/libexec",
                "/share/dbus-1/services"
            ]
        },
        {
            "name": "folks",
            "buildsystem": "meson",
            "config-opts": [
                "-Dtelepathy_backend=false",
                "-Dbluez_backend=false",
                "-Dinspect_tool=false",
                "-Dimport_tool=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/folks.git",
                    "branch": "main"
                }
            ],
            "cleanup": [
                "/bin"
            ]
        },
        {
            "name": "gmime",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/jstedfast/gmime/releases/download/3.2.15/gmime-3.2.15.tar.xz",
                    "sha256": "84cd2a481a27970ec39b5c95f72db026722904a2ccf3fdbd57b280cf2d02b5c4"
                }
            ]
        },
        {
            "name": "libpeas",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgtk_doc=false",
                "-Dintrospection=true",
                "-Dvapi=true",
                "-Dlua51=false",
                "-Dgjs=false",
                "-Dpython3=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/libpeas",
                    "branch": "main"
                }
            ]
        },
        {
            "name": "libytnef",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/Yeraze/ytnef.git",
                    "branch": "v1.9.3"
                }
            ]
        },
        {
            "name": "snowball",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/snowballstem/snowball.git",
                    "branch": "main"
                }
            ],
            "build-commands": [
                "make libstemmer.a -j$FLATPAK_BUILDER_N_JOBS CFLAGS='-g -O2 -fPIC'",
                "printf 'SB_STEMMER_0 {\\n global: sb_stemmer_*;\\n local: *;\\n};\\n' > symbol.map",
                "gcc -shared -Wl,-soname,libstemmer.so.0 -Wl,--version-script,symbol.map -Wl,--whole-archive libstemmer.a -Wl,--no-whole-archive -o libstemmer.so.0.0.0",
                "install -Dm644 include/libstemmer.h /app/include/libstemmer.h",
                "install -Dm644 libstemmer.so.0.0.0 /app/lib/libstemmer.so.0.0.0",
                "ln -s libstemmer.so.0.0.0 /app/lib/libstemmer.so.0",
                "ln -s libstemmer.so.0 /app/lib/libstemmer.so"
            ]
        },
        {
            "name": "convey",
            "buildsystem": "meson",
            "build-options": {
                "test-args": [
                    "--share=ipc",
                    "--socket=session-bus",
                    "--socket=x11",
                    "--socket=wayland",
                    "--device=dri",
                    "--socket=pulseaudio",
                    "--share=network",
                    "--env=WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1",
                    "--env=WEBKIT_DISABLE_DMABUF_RENDERER=1"
                ]
            },
            "config-opts": [
                "-Dprofile=development",
                "-Dlibunwind=disabled"
            ],
            "run-tests": true,
            "sources": [
                {
                    "type": "dir",
                    "path": "./"
                }
            ]
        }
    ]
}
